pipeline {

    agent any


    environment {

        IMAGE_NAME = "psw-nginx"

        HARBOR = "localhost:8088"

    }


    stages {


        stage('Checkout') {

            steps {

                checkout scm

            }

        }



        stage('Build Image') {

            steps {

                dir('app') {

                    sh """

                    docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .

                    """

                }

            }

        }



        stage('Login Harbor') {

            steps {

                withCredentials([usernamePassword(

                    credentialsId: 'harbor-creds',

                    usernameVariable: 'USER',

                    passwordVariable: 'PASS'

                )]) {


                    sh """

                    echo \$PASS | docker login ${HARBOR} -u \$USER --password-stdin

                    """

                }

            }

        }



        stage('Push Image') {

            steps {

                sh """

                docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${HARBOR}/library/${IMAGE_NAME}:${BUILD_NUMBER}


                docker push ${HARBOR}/library/${IMAGE_NAME}:${BUILD_NUMBER}

                """

            }

        }



        stage('Deploy Green') {

            steps {

                sh """

                echo "Deploying new version"


                export GREEN_TAG=${BUILD_NUMBER}

                export BLUE_TAG=$(grep BLUE_TAG .env | cut -d '=' -f2)


                docker compose up -d app-green


                """

            }

        }



        stage('Health Check Green') {

            steps {

                sh """

                sleep 10


                curl -f http://localhost:8085 || exit 1

                """

            }

        }



        stage('Switch Traffic') {

            steps {

                sh """

                sed -i 's/app-blue/app-green/g' nginx/default.conf


                docker exec psw-proxy nginx -s reload


                """

            }

        }



        stage('Rollback Ready') {

            steps {

                echo "Old blue container is kept for rollback"

            }

        }


    }


    post {


        failure {

            sh """

            echo "Deployment failed - keeping old version"

            sed -i 's/app-green/app-blue/g' nginx/default.conf || true


            docker exec psw-proxy nginx -s reload || true

            """

        }

    }

}
